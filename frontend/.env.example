# API Configuration (scheme optional on Railway: host-only is auto-prefixed with https://)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: public URL of this Next app (payment return URLs). Same rules as SITE_URL.
# NEXT_PUBLIC_APP_URL=https://your-frontend.up.railway.app

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=nita_clinics_uploads

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# Analytics (optional)
NEXT_PUBLIC_GA_TRACKING_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_CHATBOT=true
NEXT_PUBLIC_ENABLE_VIRTUAL_TOUR=true
