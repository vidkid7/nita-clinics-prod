# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Database — local dev uses the vars below; Railway/production typically sets DATABASE_URL only.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=dental_user
DATABASE_PASSWORD=dental_password
DATABASE_NAME=dental_db
# When using DATABASE_URL (e.g. Railway), optional pool size for TypeORM/pg (default 20).
# DATABASE_POOL_MAX=20

# Redis — prefer REDIS_URL on Railway (single URL for Bull queues + optional response cache).
# If unset, Redis cache is disabled (DB still used); Bull falls back to REDIS_HOST/REDIS_PORT.
# REDIS_URL=redis://default:password@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary — all admin uploads (photos, videos, PDFs/docs) go here when set.
# Required when NODE_ENV=production (API will not start without these).
# Dev: optional; if unset, files are written under frontend/public (not for production).
# https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@nitaclinics.com

# SMS (Mock - configure actual provider later)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=

# WhatsApp (Mock - configure actual provider later)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Password Reset
JWT_RESET_SECRET=your-super-secret-reset-key-change-in-production
JWT_RESET_EXPIRES_IN=15m

# Payment Gateways
PAYMENT_SANDBOX_MODE=true

# eSewa
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_BASE_URL=https://rc-epay.esewa.com.np

# Khalti
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://a.khalti.com

# Fonepay
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET_KEY=
FONEPAY_BASE_URL=https://dev-clientapi.fonepay.com
FONEPAY_VERIFY_URL=https://dev-merchantapi.fonepay.com
FONEPAY_USERNAME=
FONEPAY_PASSWORD=

# App URL (used for payment return URLs)
APP_URL=http://localhost:3002

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
