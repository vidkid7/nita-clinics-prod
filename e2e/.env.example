# Copy to e2e/.env and fill in (never commit e2e/.env).
# Frontend + backend must be running (e.g. npm run dev from repo root).

PLAYWRIGHT_BASE_URL=http://localhost:3002

# Optional: authenticated tests are skipped if these are empty.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

E2E_PATIENT_EMAIL=
E2E_PATIENT_PASSWORD=
